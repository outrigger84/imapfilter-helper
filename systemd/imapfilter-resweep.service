[Unit]
Description=IMAPFilter Helper - all-folders resweep (retention + INBOX-timer safety net)
Wants=network-online.target
After=network-online.target
# Uncomment (and create imapfilter-alert@.service) for a systemd-level alert
# on top of the tool's own Gotify/Telegram notifications - those only fire
# for failures the Python process itself catches, not an early crash before
# the notifier loads:
# OnFailure=imapfilter-alert@%n.service

[Service]
Type=oneshot
WorkingDirectory=/root/imapfilter-helper
# Runs the normal rules/ set against every folder except the ones below.
# This is the only mechanism that re-evaluates age-gated action brackets
# (e.g. retention rules) on mail already filed outside INBOX, since
# imapfilter-inbox.timer only ever scans INBOX. Superseded the old
# --rules-dir rules-retention tag-then-sweep design after custom IMAP
# keywords proved unreliable on iCloud (see memory
# icloud-custom-keyword-limit.md).
#
# Exclude list rather than an allow-list of bracket-rule folders on
# purpose: the plan is for most rules to eventually carry age-gated
# brackets, so an allow-list would need constant upkeep -- these five are
# the ones that will never need a retention sweep regardless of how many
# rules get brackets. --exclude-folders is an exact match (not a prefix),
# so Sent Messages' two subfolders need listing separately.
#
# --notification-summary replaces the per-match/per-action notifications
# with one digest per phase -- without it, a run touching tens of
# thousands of matches would send one notification per match.
#
# --prune-empty-folders removes leaf folders left with no messages and no
# subfolders after this sweep moves everything out of them (e.g. a
# newsletter folder that's been fully purged to Deleted Messages). --yes
# is required here: the normal per-folder "Remove X? [y/N]" prompt has no
# TTY to answer it in a systemd context and would just fail. Every
# deletion is still appended to --prune-log for after-the-fact review.
ExecStart=/root/imapfilter-helper/scripts/run_scheduled.sh 7200 --notification-summary stream --all-folders --fresh \
  --exclude-folders "INBOX" \
  --exclude-folders "Deleted Messages" \
  --exclude-folders "Junk" \
  --exclude-folders "Sent Messages" \
  --exclude-folders "Sent Messages/Away From Computer" \
  --exclude-folders "Sent Messages/Tripit" \
  --exclude-folders "Drafts" \
  --prune-empty-folders --yes --prune-log data/pruned-folders.log
